b33-4454-85be-6f1ac788fd1f":{"value":{"id":"7bb50989-4b33-4454-85be-6f1ac788fd1f","version":1,"type":"text","properties":{"title":[["Avec l'avènement de l'informatique dans les années 1940, les premiers ordinateurs électronique ont été conçus pour effectuer des calculs complexes et manipuler des données stockées sous forme de tableaux."]]},"format":{"copied_from_pointer":{"id":"2f07d061-ceb7-4175-9796-bb2d1d1bb7d9","table":"block","spaceId":"adba2cb3-b809-41d0-b7a2-c0e7bfb7edbc"}},"created_time":1719920998116,"last_edited_time":1719920998116,"parent_id":"2d9e7a92-5708-4019-907f-35780362cd27","parent_table":"block","alive":true,"copied_from":"2f07d061-ceb7-4175-9796-bb2d1d1bb7d9","space_id":"adba2cb3-b809-41d0-b7a2-c0e7bfb7edbc"},"role":"reader"},"2056ab55-1bc1-4b1f-bda4-b088a6c679fb":{"value":{"id":"2056ab55-1bc1-4b1f-bda4-b088a6c679fb","version":1,"type":"text","properties":{"title":[["Au milieu des années 1980, les feuilles de calcul deviennent populaires en permettant aux utilisateurs de créer des tableaux de données sur des ordinateurs personnels. C’est l’avènement des tableurs. "]]},"format":{"copied_from_pointer":{"id":"0babec6e-853d-47fe-bdd3-f055f4d648ed","table":"block","spaceId":"adba2cb3-b809-41d0-b7a2-c0e7bfb7edbc"}},"created_time":1719920998115,"last_edited_time":1719920998115,"parent_id":"2d9e7a92-5708-4019-907f-35780362cd27","parent_table":"block","alive":true,"copied_from":"0babec6e-853d-47fe-bdd3-f055f4d648ed","space_id":"adba2cb3-b809-41d0-b7a2-c0e7bfb7edbc"},"role":"reader"},"64402ba4-9802-4796-ab93-8d37154a0d2e":{"value":{"id":"64402ba4-9802-4796-ab93-8d37154a0d2e","version":1,"type":"text","properties":{"title":[["Aujourd'hui, les tableaux de données restent un élément essentiel de la gestion de l'information dans de nombreux domaines, de l'entreprise à la science des données en passant par la recherche et bien d'autres. Les méthodes de stockage et de gestion des données continuent d'évoluer pour faire face aux défis posés par la quantité croissante de données générées par les activités humaines et les dispositifs connectés."]]},"format":{"copied_from_pointer":{"id":"4ae333d3-30f3-4c1f-aded-6def3f22e178","table":"block","spaceId":"adba2cb3-b809-41d0-b7a2-c0e7bfb7edbc"}},"created_time":1719920998116,"last_edited_time":1719920998116,"parent_id":"2d9e7a92-5708-4019-907f-35780362cd27","parent_table":"block","alive":true,"copied_from":"4ae333d3-30f3-4c1f-aded-6def3f22e178","space_id":"adba2cb3-b809-41d0-b7a2-c0e7bfb7edbc"},"role":"reader"},"6c226784-6164-4f61-bcea-b421ff439248":{"value":{"id":"6c226784-6164-4f61-bcea-b421ff439248","version":1,"type":"text","properties":{"title":[["Les outils de visualisation de données se basent sur des tableaux de données pour créer des graphiques.   "]]},"format":{"copied_from_pointer":{"id":"b85bde9e-c74b-48c8-8a12-9f4ef44b3d40","table":"block","spaceId":"adba2cb3-b809-41d0-b7a2-c0e7bfb7edbc"}},"created_time":1719920998116,"last_edited_time":1719920998116,"parent_id":"2d9e7a92-5708-4019-907f-35780362cd27","parent_table":"block","alive":true,"copied_from":"b85bde9e-c74b-48c8-8a12-9f4ef44b3d40","space_id":"adba2cb3-b809-41d0-b7a2-c0e7bfb7edbc"},"role":"reader"},"bb325683-b6fc-4532-a25a-1634d3b51016":{"value":{"id":"bb325683-b6fc-4532-a25a-1634d3b51016","version":1,"type":"bulleted_list","properties":{"title":[["Chronologie",[["a","https://cdn.knightlab.com/libs/timeline3/latest/embed/index.html?source=1bns3y9XUbmrxwYhevdCsW19cwzPFDiLi1mnwI_neuBA&font=Default&lang=en&initial_zoom=2&height=650"]]],[" de l’histoire de la dataviz "]]},"format":{"copied_from_pointer":{"id":"1bba1f49-d3c5-4903-a1df-810fe7026db0","table":"block","spaceId":"adba2cb3-b809-41d0-b7a2-c0e7bfb7edbc"}},"created_time":1719920998115,"last_edited_time":1719920998115,"parent_id":"2d9e7a92-5708-4019-907f-35780362cd27","parent_table":"block","alive":true,"copied_from":"1bba1f49-d3c5-4903-a1df-810fe7026db0","space_id":"adba2cb3-b809-41d0-b7a2-c0e7bfb7edbc"},"role":"reader"},"b9f0ec14-8160-4383-bee9-c7beb855e143":{