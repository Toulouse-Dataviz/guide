e":true,"copied_from":"6e6890f4-bc8b-4f73-aab1-c3f81ec298dc","space_id":"adba2cb3-b809-41d0-b7a2-c0e7bfb7edbc"},"role":"reader"},"133bfef9-46e7-4058-bff6-bbfe3ddd6fa8":{"value":{"id":"133bfef9-46e7-4058-bff6-bbfe3ddd6fa8","version":1,"type":"sub_sub_header","properties":{"title":[["Guide de datavisualisation",[["_"]]]]},"format":{"copied_from_pointer":{"id":"3f3b11bb-dcd8-4990-a20c-3eef43c1b02b","table":"block","spaceId":"adba2cb3-b809-41d0-b7a2-c0e7bfb7edbc"}},"created_time":1719920998070,"last_edited_time":1719920998070,"parent_id":"f897885e-7fa4-4981-a82c-8517703e3978","parent_table":"block","alive":true,"copied_from":"3f3b11bb-dcd8-4990-a20c-3eef43c1b02b","space_id":"adba2cb3-b809-41d0-b7a2-c0e7bfb7edbc"},"role":"reader"},"b31c42d7-9a47-46e9-9af8-31a24d380b27":{"value":{"id":"b31c42d7-9a47-46e9-9af8-31a24d380b27","version":1,"type":"text","format":{"copied_from_pointer":{"id":"fd121057-7879-4381-8a77-886a28d2d64c","table":"block","spaceId":"adba2cb3-b809-41d0-b7a2-c0e7bfb7edbc"}},"created_time":1719920998071,"last_edited_time":1719920998071,"parent_id":"f897885e-7fa4-4981-a82c-8517703e3978","parent_table":"block","alive":true,"copied_from":"fd121057-7879-4381-8a77-886a28d2d64c","space_id":"adba2cb3-b809-41d0-b7a2-c0e7bfb7edbc"},"role":"reader"},"4d07fa8c-1477-4141-9ee5-324576cd6e67":{"value":{"id":"4d07fa8c-1477-4141-9ee5-324576cd6e67","version":1,"type":"text","properties":{"title":[["Réaliser un diagramme ",[["i"]]],["permet de révéler les informations contenues dans les jeux de données."]]},"format":{"copied_from_pointer":{"id":"08ffeef4-fae1-42bb-8eb2-54cb5fb3b87e","table":"block","spaceId":"adba2cb3-b809-41d0-b7a2-c0e7bfb7edbc"}},"created_time":1719920998069,"last_edited_time":1719920998069,"parent_id":"f897885e-7fa4-4981-a82c-8517703e3978","parent_table":"block","alive":true,"copied_from":"08ffeef4-fae1-42bb-8eb2-54cb5fb3b87e","space_id":"adba2cb3-b809-41d0-b7a2-c0e7bfb7edbc"},"role":"reader"},"788d940d-cd13-4781-abb0-bc57e816d8a1":{"value":{"id":"788d940d-cd13-4781-abb0-bc57e816d8a1","version":1,"type":"text","properties":{"title":[[" La création de diagrammes suit les règles générales du design graphique, mais aussi celles, plus spécifiques, de la visualisation de données. Ces dernières, mises en avant par Jacques Bertin dans “La sémiologie graphique” (1967) ont fait progresser la représentation visuelle de l'information. "]]},"format":{"copied_from_pointer":{"id":"631579ae-58b8-4376-90a1-c0163e3695c9","table":"block","spaceId":"adba2cb3-b809-41d0-b7a2-c0e7bfb7edbc"}},"created_time":1719920998070,"last_edited_time":1719920998070,"parent_id":"f897885e-7fa4-4981-a82c-8517703e3978","parent_table":"block","alive":true,"copied_from":"631579ae-58b8-4376-90a1-c0163e3695c9","space_id":"adba2cb3-b809-41d0-b7a2-c0e7bfb7edbc"},"role":"reader"},"c1676365-e99a-45e6-8c02-660abe8c647b":{"value":{"id":"c1676365-e99a-45e6-8c02-660abe8c647b","version":75,"type":"text","properties":{"title":[["Mike Bostock, le créateur de la librairies d3.js, a aussi joué un rôle clé dans l'avancement de la visualisation de données en introduisant des concepts novateurs et des techniques de programmation permettant de créer des graphiques complexes, des cartes interactives et d'autres types de visualisations. Son travail a eu une influence significative sur la communauté de la visualisation de données et a contribué  au développement de visualisations web sophistiquées."]]},"format":{"copied_from_pointer":{"id":"e7e8819f-1530-4a40-9486-e8eaf1cca6c6","table":"block","spaceId":"adba2cb3-b809-41d0-b7a2-c0e7bfb7edbc"}},"created_time":1719920998071,"last_edited_time":1719921708503,"parent_id":"f897885e-7fa4-4981-a82c-8517703e3978","parent_table":"block","alive":true,"copied_from":"e7e8819f-1530-4a40-9486-e8eaf1cca6c6","space_id":"adba2cb3-b809-41d0-b7a2-c0e7bfb7edbc"},"role":"reader"},"ea87a2d3-cc46-41fd-a809-bc419bc63bbe":{"value":{"id":"ea87a2d3-cc46-41fd-a809-bc419bc63bbe","version":1,"type":"text","properties":{"title":[["\nCe guide, écrit en français, permet de découvrir ou se remémorer les principaux concepts utilisés en datavisualisation et s’adresse à des débutants ou à des personnes plus expérimentées. \nConstitué en thèmes, il sera progressivement enrichi pour couvrir de nouveaux diagrammes et couvrir l’ensemble des concepts de la datavisualisation.  "]]},"format":{"copied_from_pointer":{"id":"c0c5c1d5-c642-46a1-9516-37e27891f70b","table":"block","spaceId":"adba2cb3-b809-41d0-b7a2-c0e7bfb7edbc"}},"created_time":1719920998070,"last_edited_time":1719920998070,"parent_id":"f897885e-7fa4-4981-a82c-8517703e3978","parent_table":"block","alive":true,"copied_from":"c0c5c1d5-c642-46a1-9516-37e27891f70b","space_id":"adba2cb3-b809-41d0-b7a2-c0e7bfb7edbc"},"role":"reader"},"4bfc11d8-e95c-401f-8cae-eced2bc0c832":{"value":{"id":"4bfc11d8-e95c-401f-8cae-eced2bc0c832","version":1,"type":"text","properties":{"title":[["L’originalité de ce guide est de proposer des outils graphiques interactifs qui permettent à l’utilisateur de tester les recommandations présentées. "]]},"format":{"copied_from_pointer":{"id":"8d3fef18-ab2e-4903-b976-7d863ae8937b","table":"block","spaceId":"adba2cb3-b809-41d0-b7a2-c0e7bfb7edbc"}},"created_time":1719920998070,"last_edited_time":1719920998070,"parent_id":"f897885e-7fa4-4981-a82c-8517703e3978","parent_table":"block","alive":true,"copied_from":"8d3fef18-ab2e-4903-b976-7d863ae8937b","space_id":"adba2cb3-b809-41d0-b7a2-c0e7bfb7edbc"},"role":"reader"},"deff50cd-6711-4ba3-85b6-5fadee891538":{"value":{"id":"deff50cd-6711-4ba3-85b6-5fadee891538","version":1,"type":"text","format":{"copied_from_pointer":{"id":"1e9a2dcf-7f27-4ff3-94f5-745d6b7c5f84","table":"block","spaceId":"adba2cb3-b809-41d0-b7a2-c0e7bfb7edbc"}},"created_time":1719920998070,"last_edited_time":1719920998070,"parent_id":"f897885e-7fa4-4981-a82c-8517703e3978","parent_table":"block","alive":true,"copied_from":"1e9a2dcf-7f27-4ff3-94f5-745d6b7c5f84","space_id":"adba2cb3-b809-41d0-b7a2-c0e7bfb7edbc"},"role":"reader"},"cc266d06-739a-490a-b992-3e582f25b781":{"value":{"id":"cc266d06-739a-490a-b992-3e582f25b781","version":1,"type":"sub_sub_header","properties":{"title":[["Sélection d’outils",[["_"]]],[" "]]},"format":{"copied_from_pointer":{"id":"bb808258-3408-4698-8e5e-730db75bfd94","table":"block","spaceId":"adba2cb3-b809-41d0-b7a2-c0e7bfb7edbc"}},"created_time":1719920998070,"last_edited_time":1719920998070,"parent_id":"f897885e-7fa4-4981-a82c-8517703e3978","parent_table":"block","alive":true,"copied_from":"bb808258-3408-4698-8e5e-730db75bfd94","space_id":"adba2cb3-b809-41d0-b7a2-c0e7bfb7edbc"},"role":"reader"},"21fdb6ad-2bd5-4b39-b1ce-d90dc7fefb82":{"value":{"id":"21fdb6ad-2bd5-4b39-b1ce-d90dc7fefb82","version":1,"type":"text","properties":{"title":[["Des exemples sont aussi réalisés à partir de logiciels couramment utilisés pour faciliter la mise en pratique. \nNous vous proposons des diagrammes, des variantes et des lignes directrices, mais peut-on les mettre en œuvre concrètement  avec les outils graphiques ? La liste des logiciels de visualisation de données est longue et en faire une analyse exhaustive serait fastidieuse et peu pratique à utiliser. Nous avons choisi quelques outils connus,  facile d’accès pour des débutants et qui permettent  d’exporter les graphiques dans un format vectoriel (.svg) à l’exception de l’outil Tableau public (1)"]]},"format":{"copied_from_pointer":{"id":"ae6a8fde-2c4a-40fa-a30c-ffb05dd24c57","table":"block","spaceId":"adba2cb3-b809-41d0-b7a2-c0e7bfb7edbc"}},"created_time":1719920998070,"last_edited_time":1719920998070,"parent_id":"f897885e-7fa4-4981-a82c-8517703e3978","parent_table":"block","alive":true,"copied_from":"ae6a8fde-2c4a-40fa-a30c-ffb05dd24c57","space_id":"adba2cb3-b809-41d0-b7a2-c0e7bfb7edbc"},"role":"reader"},"df957330-76a9-473a-b47e-cb8397cb065b":{"value":{"id":"df957330-76a9-473a-b47e-cb8397cb065b","version":1,"type":"text","properties":{"title":[["Dans ce format svg, les diagrammes se composent d’un ensemble d’objets graphiques (polygones, lignes, cercles et textes) qu’il est alors possible d’exporter dans des outils de présentation tels que "],["PowerPoint",[["h","blue"]]],[",  "],["Draw",[["h","blue"]]],[" ou des outils vectoriels dédiés  comme "],["Illustrator",[["_"],["h","blue"]]],[" ou son équivalent libre "],["Inkscape",[["_"],["h","blue"]]],[".  Des modifications, difficilement réalisables avec l’outil de dataviz, sont alors possible  manuellement ."]]},"format":{"copied_from_pointer":{"id":"259f0408-c1d6-4f9a-bb9a-52b48d410fc5","table":"block","spaceId":"adba2cb3-b809-41d0-b7a2-c0e7bfb7edbc"}},"created_time":1719920998070,"last_edited_time":1719920998070,"parent_id":"f897885e-7fa4-4981-a82c-8517703e3978","parent_table":"block","alive":true,"copied_from":"259f0408-c1d6-4f9a-bb9a-52b48d410fc5","space_id":"adba2cb3-b809-41d0-b7a2-c0e7bfb7edbc"},"role":"reader"},"69046d84-6507-482e-ba70-2492d0bf908a":{"value":{"id":"69046d84-6507-482e-ba70-2492d0bf908a","version":1,"type":"text","format":{"copied_from_pointer":{"id":"ead49977-790c-468c-9c9b-c941b3471a80","table":"block","spaceId":"adba2cb3-b809-41d0-b7a2-c0e7bfb7edbc"}},"created_time":1719920998071,"last_edited_time":1719920998071,"parent_id":"f897885e-7fa4-4981-a82c-8517703e3978","parent_table":"block","alive":true,"copied_from":"ead49977-790c-468c-9c9b-c941b3471a80","space_id":"adba2cb3-b809-41d0-b7a2-c0e7bfb7edbc"},"role":"reader"},"37add17d-3936-4f1e-bb32-48e0e137cc55":{"value":{"id":"37add17d-3936-4f1e-bb32-48e0e137cc55","version":1,"type":"sub_sub_header","properties":{"title":[["Outils de datavisualisation",[["_"]]],[" "]]},"format":{"copied_from_pointer":{"id":"7e4dae15-fb84-437d-a163-0aa8e0ea4bbf","table":"block","spaceId":"adba2cb3-b809-41d0-b7a2-c0e7bfb7edbc"}},"created_time":1719920998070,"last_edited_time":1719920998070,"parent_id":"f897885e-7fa4-4981-a82c-8517703e3978","parent_table":"block","alive":true,"copied_from":"7e4dae15-fb84-437d-a163-0aa8e0ea4bbf","space_id":"adba2cb3-b809-41d0-b7a2-c0e7bfb7edbc"},"role":"reader"},"e63f0539-e0f5-4cfe-